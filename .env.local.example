# Copy to .env.local and fill in values before running.

# Supabase (self-hosted)
NEXT_PUBLIC_SUPABASE_URL=https://supabase.sdrc.in
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Port override (default: 3010)
# PORT=3010

# Protocol for internal Puppeteer PDF rendering (default: http — do not change to https on self-hosted)
# RENDER_PROTO=http

# DICOM sidecar base URL — reuses DICOM_SEND_URL if already set (no trailing slash)
# DICOM_SEND_URL=http://100.103.168.62:8085

# Labit Core — "Push to Labit" on the report print pages sends the finished
# PDF here as an attachment for doctor approval (Labit handles delivery to
# the patient itself; this app never sends to the patient directly).
LABIT_CORE_BASE_URL=https://labit.sdrc.in
LABIT_ATTACHMENT_INTERNAL_TOKEN=your-internal-token
LABIT_BMD_TB_TEST_REF=BWB
LABIT_BMD_SPINE_AP_TEST_REF=BAP
LABIT_BMD_HIP_SINGLE_TEST_REF=BHIP
LABIT_BMD_HIP_BOTH_TEST_REF=BBH
LABIT_BMD_FOREARM_TEST_REF=BMW
